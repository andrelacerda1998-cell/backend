{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "bavix/laravel-wallet": "^11.3",
        "bezhansalleh/filament-language-switch": "^3.1",
        "codeat3/blade-vaadin-icons": "^1.6",
        "davidhsianturi/blade-bootstrap-icons": "^2.2",
        "dutchcodingcompany/filament-developer-logins": "^1.2",
        "filament/filament": "^3.2",
        "filament/spatie-laravel-media-library-plugin": "^3.2",
        "filament/spatie-laravel-settings-plugin": "^3.2",
        "guzzlehttp/guzzle": "^7.9",
        "http-interop/http-factory-guzzle": "^1.2",
        "joaopaulolndev/filament-edit-profile": "^1.0",
        "kainiklas/filament-scout": "^0.4.0",
        "laravel-notification-channels/expo": "^2.0",
        "laravel-notification-channels/twilio": "4.1.3",
        "laravel-validation-rules/credit-card": "^1.9",
        "laravel/fortify": "^1.24",
        "laravel/framework": "^12.0",
        "laravel/horizon": "^5.32",
        "laravel/pail": "^1.1",
        "laravel/pulse": "^1.4",
        "laravel/reverb": "^1.0",
        "laravel/scout": "^10.11",
        "laravel/telescope": "^5.2",
        "laravel/tinker": "^2.9",
        "livewire/livewire": "^3.6.4",
        "meilisearch/meilisearch-php": "^1.10",
        "mokhosh/filament-rating": "^1.4",
        "mvenghaus/filament-plugin-schedule-monitor": "^3.0",
        "nembie/iban-rule": "^1.0",
        "owen-it/laravel-auditing": "^14.0",
        "pxlrbt/filament-environment-indicator": "^2.0",
        "rwi/payshop-sdk": "@dev",
        "skagarwal/google-places-api": "^3.0",
        "solution-forest/filament-translate-field": "^1.3",
        "spatie/geocoder": "^3.16",
        "spatie/laravel-medialibrary": "^11.9",
        "spatie/laravel-permission": "^6.9",
        "spatie/laravel-schedule-monitor": "^3.10",
        "spatie/laravel-settings": "^3.4",
        "spatie/laravel-translatable": "^6.9",
        "stephenjude/filament-debugger": "^4.0",
        "tapp/filament-auditing": "^3.0",
        "tapp/filament-value-range-filter": "^1.0",
        "tymon/jwt-auth": "^2.1",
        "vormkracht10/filament-2fa": "^1.6"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.14",
        "fakerphp/faker": "^1.23",
        "laravel/boost": "^1.8",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0.1",
        "soloterm/solo": "^0.5.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "helpers/distance.php",
            "helpers/wallet.php",
            "helpers/normalizeAcceptLanguage.php",
            "helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "test:sqlite": [
            "Composer\\Config::disableProcessTimeout",
            "DB_CONNECTION=sqlite DB_DATABASE=:memory: BROADCAST_CONNECTION=log SCOUT_DRIVER=collection WALLET_CACHE_DRIVER=array WALLET_LOCK_DRIVER=array vendor/bin/phpunit"
        ]
    },
    "provide": {
        "illuminate/support": "~11.0"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": {
        "payshop-sdk": {
            "type": "path",
            "url": "../payshop-sdk",
            "options": {
                "symlink": true
            }
        }
    }
}

# === PRODUÇÃO — copiar para .env e preencher os segredos ===
# Difere do .env.example (local) nos defaults endurecidos: debug OFF, Telescope OFF, cookie
# Secure ON, log em info, proxies/CORS pinados, sandboxes de pagamento/faturação desligados.
# NUNCA copiar o .env.example (local) para produção — herda APP_DEBUG=true + Telescope aberto.

# --- Application ---
APP_NAME=Piquet
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME
APP_PORT=8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# --- Segurança: Proxy confiável & CORS ---
# Pinar ao CIDR do edge/LB para o X-Forwarded-For não ser falsificável (NÃO usar '*' em produção).
TRUSTED_PROXIES=127.0.0.1
# Listar os domínios de browser permitidos (o backoffice é same-origin; apps nativas ignoram CORS).
CORS_ALLOWED_ORIGINS=https://CHANGE_ME

# --- Logging ---
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# --- Database (MySQL) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Cache / Queue / Session / Filesystem ---
CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# HTTPS obrigatório em produção — o cookie de sessão guarda o hash do código 2FA do backoffice.
SESSION_SECURE_COOKIE=true
FILESYSTEM_DISK=local
MEMCACHED_HOST=127.0.0.1

# --- Redis ---
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

# --- Broadcast / Reverb (websockets) ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="0.0.0.0"
REVERB_PORT=8080
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- Search (Meilisearch) ---
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=

# --- Mail ---
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="donotreply@piquetapp.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- AWS (opcional / S3) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Google Maps (geocoding) ---
GOOGLE_MAPS_GEOCODING_API_KEY=

# --- Payshop / Paylands ---
PAYSHOP_SDK_ENVIRONMENT=production
PAYSHOP_SDK_CLIENT_UUID=
PAYSHOP_SDK_API_KEY=
PAYSHOP_SDK_API_SIGNATURE=
PAYSHOP_SDK_CREDIT_CARD_SERVICE_UUID=
PAYSHOP_SDK_MBWAY_SERVICE_UUID=
PAYSHOP_SDK_CUSTOMER_PREFIX=

# --- InvoiceXpress (faturação) ---
INVOICE_XPRESS_SANDBOX=false
INVOICE_XPRESS_BASE_URL="app.invoicexpress.com"
INVOICE_XPRESS_ACCOUNT=
INVOICE_XPRESS_ACCOUNT_ID=
INVOICE_XPRESS_API_KEY=
INVOICE_XPRESS_EMAIL=
INVOICE_XPRESS_NIF=
INVOICE_XPRESS_PASSWORD=
INVOICE_XPRESS_PRODUCT_NAME=Service
INVOICE_SEQUENCES=PIQUET-%s-%s

# --- Twilio (SMS) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_ALPHA_SENDER=Piquet
TWILIO_DEBUG_TO=
TWILIO_SHORTEN_URLS=true

# --- Auth (JWT) ---
JWT_SECRET=

# --- Debug / Dev tooling (DESLIGADO em produção) ---
TELESCOPE_ENABLED=false
VITE_APP_NAME="${APP_NAME}"

# --- Mocks (têm de ficar OFF em produção; MOCK_SMS só funciona fora de produção — ver F-01) ---
MOCK_SMS=false
MOCK_LOCATION=false
